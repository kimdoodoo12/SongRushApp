# Tells DuckDNS this server's current IP. duckdns-setup.sh copies this to
# /etc/systemd/system/ and duckdns.timer runs it. DuckDNS answers OK or KO;
# KO (wrong name or token) still counts as success here, so check the reply
# with: journalctl -u duckdns -n 20
[Unit]
Description=Update the DuckDNS name to this server's IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2min
ExecStart=/usr/bin/curl -fsS -K /etc/songrush/duckdns.curl
