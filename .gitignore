# secrets
.env
.env.*
!.env.example
*.pem
*.key

# claude local state
.claude/state/
.claude/settings.local.json

# frontend (node)
node_modules/
dist/
coverage/

# backend (gradle)
backend/build/
backend/bin/
backend/.gradle/
.gradle/

# data (python); data/catalog.json stays tracked
data/.venv/
.venv/
.pytest_cache/
__pycache__/
*.pyc

# data: API caches and media never go into git
data/cache/
*.mp3
*.ogg
*.webm
*.m4a
*.mp4

# misc
*.log
.DS_Store
.idea/
.vscode/

# data: a killed build can leave its lock and temp files next to the catalog
data/.build.lock
data/~tmp-*

# data: the audio cache (files, .part leftovers, index.json, lock); never in git
data/audio-cache/

# data: the cover cache (images, .part leftovers, index.json, lock); never in git
data/cover-cache/

# docker image exports (docker save) never go into git
*.tar
