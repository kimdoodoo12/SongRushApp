{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push -u origin cycle/:*)",
      "Bash(git push origin cycle/:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo view:*)",
      "Bash(python -I .claude/hooks/lock.py:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl -s http://localhost:*)",
      "PowerShell(npm:*)",
      "PowerShell(npx:*)",
      "WebFetch(domain:api.animethemes.moe)",
      "WebFetch(domain:animethemes.moe)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"", "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_on_stop.py\"", "timeout": 900 },
          { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify_discord.py\" stop", "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_on_stop.py\"", "timeout": 900 }
        ]
      }
    ]
  }
}
